{
  "name": "mycel-harness",
  "private": true,
  "version": "0.2.0",
  "description": "The agentic kernel behind Mycel — a harness that runs client work in disposable sandboxes, holds every deliverable for a human signature, and keeps the corrections.",
  "license": "Apache-2.0",
  "homepage": "https://mycelai.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycelhq/mycel.git"
  },
  "keywords": [
    "agents",
    "agent-harness",
    "llm",
    "sandbox",
    "human-in-the-loop",
    "deliverables"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env harness/src/index.ts",
    "start": "tsx --env-file-if-exists=.env harness/src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "node scripts/typecheck-tests.mjs",
    "check": "npm run typecheck && npm test",
    "funnel": "node scripts/activation-funnel.mjs",
    "demo": "tsx harness/scripts/demo.ts",
    "demo:kernel": "MYCEL_RUNTIME=mock MYCEL_API_KEY=mycel_demo_key MYCEL_OWNER_EMAIL=founder@sightlineresearch.example MYCEL_OWNER_PASSWORD=demo-sightline MYCEL_LOG_DIR=.mycel/demo-logs tsx harness/src/index.ts",
    "demo:seed": "MYCEL_OWNER_EMAIL=founder@sightlineresearch.example MYCEL_OWNER_PASSWORD=demo-sightline tsx harness/scripts/seed-demo.ts",
    "sim:kernel": "PORT=4100 MYCEL_RUNTIME=mock MYCEL_API_KEY=mycel_sim_key MYCEL_OWNER_EMAIL=founder@kestrel.example MYCEL_OWNER_PASSWORD=demo-kestrel MYCEL_LOG_DIR=.mycel/sim-logs tsx harness/src/index.ts",
    "sim": "MYCEL_URL=http://localhost:4100 MYCEL_OWNER_EMAIL=founder@kestrel.example MYCEL_OWNER_PASSWORD=demo-kestrel tsx harness/scripts/simulate.ts",
    "lifecycle": "tsx harness/scripts/lifecycle-report.ts",
    "skills:harvest": "node scripts/skill-harvest.mjs",
    "skills:harvest:check": "node scripts/skill-harvest.mjs --dry-run",
    "test": "MYCEL_RUNTIME=mock MYCEL_API_KEY=testkey MYCEL_OWNER_EMAIL=owner@test.co MYCEL_OWNER_PASSWORD=secret node --import tsx --test harness/test/*.test.ts",
    "retention": "node scripts/retention.mjs",
    "test:live": "./scripts/test-live.sh",
    "test:browser": "MYCEL_TEST_BROWSER=1 MYCEL_RUNTIME=mock MYCEL_API_KEY=testkey MYCEL_OWNER_EMAIL=owner@test.co MYCEL_OWNER_PASSWORD=secret node --import tsx --test harness/test/screencast.test.ts",
    "schema": "node harness/scripts/generate-schema.mjs",
    "schema:check": "node harness/scripts/generate-schema.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1130.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1130.0",
    "@aws-sdk/client-cloudfront": "^3.1130.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1130.0",
    "@aws-sdk/client-codebuild": "^3.1130.0",
    "@aws-sdk/client-ecs": "^3.1130.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-transcribe": "^3.1130.0",
    "@daytona/sdk": "^0.211.2",
    "@hono/node-server": "^2.1.1",
    "@mycel/deliverability": "file:./packages/deliverability",
    "@mycel/gtm-math": "file:./packages/gtm-math",
    "@mycel/linkedin": "file:./packages/linkedin",
    "@mycel/sourcing": "file:./packages/sourcing",
    "@sentry/node": "^10.74.0",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
