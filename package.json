{
  "name": "mycel-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch harness/src/index.ts",
    "start": "tsx harness/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "MYCEL_RUNTIME=mock MYCEL_API_KEY=testkey MYCEL_OWNER_EMAIL=owner@test.co MYCEL_OWNER_PASSWORD=secret node --import tsx --test harness/test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "graphile-worker": "^0.17.3",
    "hono": "^4.6.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
