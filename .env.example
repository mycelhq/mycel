# ── Sandbox backend: WHERE OpenCode runs (abstracted; add more by implementing Sandbox) ──
#   local   = this machine (needs the `opencode` binary installed)
#   docker  = a local Docker container from MYCEL_SANDBOX_IMAGE (isolation, no cloud account)
#   daytona = an isolated Daytona microVM (cloud; needs DAYTONA_API_KEY)
MYCEL_SANDBOX=local
MYCEL_SANDBOX_IMAGE=mycel/sandbox:latest
OPENCODE_PORT=4444

# ── Which LLM the agent uses (provider/model). Per-task override via task.input.model. ──
#   Default is an OpenAI-compatible model so ONE key (OPENAI_API_KEY below) is all you need — no
#   proxy. openai/… and openrouter/… work directly. anthropic/… and google/… are NOT
#   OpenAI-compatible and need a LiteLLM proxy (see MYCEL_LLM_UPSTREAM below).
MYCEL_MODEL=openai/gpt-5.6-luna

# ── Proxy mode: route model calls through the harness so provider keys NEVER enter the sandbox ──
MYCEL_PROXY_MODE=0
# For non-OpenAI-compatible providers (anthropic/google), point at a LiteLLM proxy:
MYCEL_LLM_UPSTREAM=

# ── Provider keys (native mode: injected into the opencode server inside the sandbox) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ── Daytona (only when MYCEL_SANDBOX=daytona) ──
DAYTONA_API_KEY=

# ── Persistence: durable Postgres if set, else in-memory (tasks vanish on restart) ──
MYCEL_DATABASE_URL=

# ── Artifact content storage: inline (default) | fs | s3 ──
MYCEL_ARTIFACTS=inline
MYCEL_ARTIFACTS_DIR=.mycel/artifacts
MYCEL_ARTIFACTS_BUCKET=

# ── Observability ──
# Per-task JSONL event logs (always on):
MYCEL_LOG_DIR=.mycel/logs
# Per-run traces are always available at GET /v1/tasks/:id/trace — folded from the event log above,
# no configuration and no third party.
#
# Langfuse below is OPTIONAL and entirely yours: your account, your keys, your org, for when you want
# an LLM-debugging UI over your own runs. Nothing provisions a Langfuse project for anyone — that
# needed the Organization Management API, which is self-hosted Enterprise only, and was removed.
# Set both keys and run `npm install langfuse` to enable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Harness API ──
PORT=4000

# ── Composio (optional): OAuth + 250+ toolkits ────────────────────────────────
# Set this and connections of kind "composio" work: the founder clicks once to authorise Xero /
# QuickBooks / HubSpot / Gmail, Composio holds the OAuth grant and refreshes it, and this key never
# leaves the harness — the sandbox still only ever gets an opaque action nonce.
# Create one auth config per toolkit at app.composio.dev, then put its id on the connection.
# COMPOSIO_API_KEY=
# COMPOSIO_BASE_URL=https://backend.composio.dev   # override to point at a fake in tests

# ── GTM enrichment (optional) ─────────────────────────────────────────────────
# Public-page hop (already keyed on hosted: mycel/firecrawl-api-key):
# FIRECRAWL_API_KEY=
# Paid email waterfall:
# FULLENRICH_API_KEY=

# ── AgentMail (optional): the INBOUND half of email ───────────────────────────
# Set these and connections of kind "agentmail" work: a chase sends from the business's own mailbox,
# and when a client replies "I paid on the 3rd" the reply comes back through a signed webhook, lands
# on the thread it answers, and stands the dunning ladder down. Unset, everything behaves exactly as
# it did before — /v1/agentmail/webhook answers 501 rather than becoming an open endpoint.
#
# AGENTMAIL_WEBHOOK_SECRET is the Svix endpoint secret (whsec_…) from the AgentMail console, and it
# is the ENTIRE authentication of the inbound route: there is no session behind it, so without this
# the route accepts nothing at all. Point the webhook at  https://<your-harness>/v1/agentmail/webhook
# and subscribe to `message.received`.
#
# One AgentMail account serves every tenant on the deployment, so which project owns a sending domain
# — and therefore who may make a mailbox on it — is a record the kernel keeps, never a question asked
# of AgentMail. See claimDomainForProject in harness/src/agentmail.ts.
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=
# AGENTMAIL_API_URL=https://api.agentmail.to      # override to point at a fake in tests
# AGENTMAIL_WEBHOOK_TOLERANCE_S=300               # max delivery age; 0 disables the replay check

# ── Meeting join bot (optional): Chromium on ECS Fargate + Amazon Transcribe ──
# Google Meet URL only, today. Zoom/Teams need their own join path — we refuse them with a
# sentence rather than pretending. No Recall, no Deepgram, no SaaS keys. Unset → POST
# /v1/meetings/join answers 501. The bot POSTs /v1/meetings/complete with a per-join token.
#
#   MYCEL_MEETING_BOT_CLUSTER          ECS cluster (hosted: mycel)
#   MYCEL_MEETING_BOT_TASK             task definition family (hosted: mycel-meeting-bot)
#   MYCEL_MEETING_BOT_SUBNETS          comma-separated subnet ids (public, same as kernel)
#   MYCEL_MEETING_BOT_SECURITY_GROUP   meeting-bot SG (egress to Meet + S3; ingress to kernel)
#   MYCEL_MEETING_CALLBACK_URL         the kernel's own address the meeting bot calls back, e.g. http://your-kernel-host:4000
#   MYCEL_MEETING_BOT_NAME             display name in the room (default "Mycel notes")
#   MYCEL_ARTIFACTS_BUCKET             audio + Transcribe JSON land under meetings/
# MYCEL_MEETING_BOT_CLUSTER=
# MYCEL_MEETING_BOT_TASK=
# MYCEL_MEETING_BOT_SUBNETS=
# MYCEL_MEETING_BOT_SECURITY_GROUP=
# MYCEL_MEETING_CALLBACK_URL=
# MYCEL_MEETING_BOT_NAME=Mycel notes
