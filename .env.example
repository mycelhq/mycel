# ── Sandbox backend: WHERE OpenCode runs (abstracted; add more by implementing Sandbox) ──
#   local   = this machine (needs the `opencode` binary installed)
#   docker  = a local Docker container from MYCEL_SANDBOX_IMAGE (isolation, no cloud account)
#   daytona = an isolated Daytona microVM (cloud; needs DAYTONA_API_KEY)
MYCEL_SANDBOX=local
MYCEL_SANDBOX_IMAGE=mycel/sandbox:latest
OPENCODE_PORT=4444

# ── Which LLM the agent uses (provider/model). Per-task override via task.input.model. ──
#   e.g. anthropic/claude-opus-4-8 · openai/gpt-... · google/gemini-... · openrouter/...
MYCEL_MODEL=anthropic/claude-opus-4-8

# ── Proxy mode: route model calls through the harness so provider keys NEVER enter the sandbox ──
MYCEL_PROXY_MODE=0
# For non-OpenAI-compatible providers (anthropic/google), point at a LiteLLM proxy:
MYCEL_LLM_UPSTREAM=

# ── Provider keys (native mode: injected into the opencode server inside the sandbox) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ── Daytona (only when MYCEL_SANDBOX=daytona) ──
DAYTONA_API_KEY=

# ── Persistence: durable Postgres if set, else in-memory (tasks vanish on restart) ──
MYCEL_DATABASE_URL=

# ── Artifact content storage: inline (default) | fs | s3 ──
MYCEL_ARTIFACTS=inline
MYCEL_ARTIFACTS_DIR=.mycel/artifacts
MYCEL_ARTIFACTS_BUCKET=

# ── Observability ──
# Per-task JSONL event logs (always on):
MYCEL_LOG_DIR=.mycel/logs
# Langfuse tracing (opt-in; open-source, self-host or cloud). Set both keys to enable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Harness API ──
PORT=4000

# ── Composio (optional): OAuth + 250+ toolkits ────────────────────────────────
# Set this and connections of kind "composio" work: the founder clicks once to authorise Xero /
# QuickBooks / HubSpot / Gmail, Composio holds the OAuth grant and refreshes it, and this key never
# leaves the harness — the sandbox still only ever gets an opaque action nonce.
# Create one auth config per toolkit at app.composio.dev, then put its id on the connection.
# COMPOSIO_API_KEY=
# COMPOSIO_BASE_URL=https://backend.composio.dev   # override to point at a fake in tests

# ── Per-project tracing (optional) ────────────────────────────────────────────
# Each business gets its OWN Langfuse project rather than a filtered view of a shared one, because
# traces hold your customers' data and a filter is a promise about query construction rather than a
# boundary. Create an ORGANISATION-scoped key pair in Langfuse under Organization Settings — only
# organisation CREATION needs an Enterprise licence; creating projects with an org key does not.
# Absent = tracing falls back to the single shared instance, or to off.
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ORG_PUBLIC_KEY=pk-lf-org-...
# LANGFUSE_ORG_SECRET_KEY=sk-lf-org-...
